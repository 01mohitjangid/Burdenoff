# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. A hosted database (Neon, Supabase) works as-is.
#
# The three timeout settings are not optional on a serverless database. Neon and
# Supabase suspend an idle instance, and the first request has to wake it, which
# takes longer than Prisma's defaults allow: 5s to open a connection and 10s to
# take one from the pool. Leave them out and the first signup after an idle
# period fails with a 500 that looks like a bug in the app.
#
#   connect_timeout=30   seconds to wait for the database to accept a connection
#   pool_timeout=30      seconds a query waits for a free connection
#   connection_limit=10  keeps the app inside a pooled database's ceiling
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=10"

# A local Postgres needs none of that, because there is nothing to wake:
# DATABASE_URL="postgresql://habit:habit@localhost:5432/habit_tracker?schema=public"

# Signing key for session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
#
# Changing it invalidates every cookie already issued, so everyone is signed out.
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
